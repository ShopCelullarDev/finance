[Unit]
Description=Terminal Next.js del motor predictivo
After=market-api.service

[Service]
Type=simple
WorkingDirectory=%h/market/src/frontend
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/local/bin/npm run start -- --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
