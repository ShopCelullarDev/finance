# ==============================================================================
# INFRAESTRUCTURA DE DATOS (TimescaleDB & Redis)
# ==============================================================================
POSTGRES_USER=market_admin
POSTGRES_PASSWORD=market_secure_pass
POSTGRES_DB=market_predictive_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://market_admin:market_secure_pass@localhost:5432/market_predictive_db

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# BACKEND FASTAPI Y SEGURIDAD
# ==============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=market_predictive_secret_key_change_me_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==============================================================================
# VECTORES DE DATOS Y EXCHANGES (API KEYS OPCIONALES PARA FEEDS PÚBLICOS)
# ==============================================================================
BINANCE_API_KEY=
BINANCE_API_SECRET=
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
POLYMARKET_GAMMA_API_URL=https://gamma-api.polymarket.com

# ==============================================================================
# FRONTEND Y CONEXIÓN EN TIEMPO REAL
# ==============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
